# Subida a Drive y mail a soporte.
#
# Sin GOOGLE_CLIENT_ID y DRIVE_FOLDER_ID el botón "Subir a Drive y enviar" no
# aparece y la app sigue funcionando con la descarga del .docx.
#
# Son NEXT_PUBLIC_* porque todo pasa en el navegador: quedan embebidas en el
# bundle. Ninguna es un secreto — el client ID de OAuth es público por diseño y
# está atado a los orígenes autorizados que declares en Google Cloud.

# Google Cloud > APIs y servicios > Credenciales > ID de cliente de OAuth (app web).
# Agregá como orígenes autorizados http://localhost:3000 y el dominio de Vercel.
# Habilitá además la Google Drive API en ese mismo proyecto.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ID de la carpeta destino: es lo que va después de /folders/ en la URL de Drive.
# Compartila de antemano con quien tenga que leer los casos; el documento hereda
# los permisos de la carpeta y así no hace falta que la app comparta nada.
NEXT_PUBLIC_DRIVE_FOLDER_ID=

# Destinatarios del mail. Varias direcciones separadas por coma.
NEXT_PUBLIC_SUPPORT_TO=
NEXT_PUBLIC_SUPPORT_CC=
